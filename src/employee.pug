extends layout.pug

block content

    .topbar.d-flex.justify-content-between.align-items-center.p-3
        h5.mb-0 Employees

    .container-fluid.p-4

        .section.d-flex.justify-content-between.align-items-center.mb-4
            .left-content
                h5.mb-1 Employee Management
                p.text-muted.mb-0 Manage and view all employees

            .right-content
                button.btn.btn-dark#addEmployeeBtn + Add Employee

        .card.search-card.p-3.mb-3
            .filter-wrapper.d-flex.justify-content-between.align-items-center.flex-wrap

                .search-container.position-relative
                    i.bi.bi-search.search-icon
                    input#customSearch.form-control.search-input(
                        type="text"
                        placeholder="Search by name, email, or ID..."
                    )

                .status-container
                    select#statusFilter.form-select.status-select
                        option(value="") All Status
                        option(value="active" key=true) Active
                        option(value="inactive" key=false) Inactive

        .card.p-3
            .table-responsive
                table#employeeTable.table.table-striped(style="width:100%")
                    thead
                        tr
                            th Name
                            th Email
                            th Department
                            th Branch
                            th Status
                            th Assets
                            th Join Date
                            th Action
                    tbody


        script(type="module" src="./ts/employee.ts")
