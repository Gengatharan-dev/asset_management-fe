extends layout.pug

block content

    .topbar.d-flex.justify-content-between.align-items-center.p-3
        h5.mb-0 Dashboard

    .container-fluid.p-4

        // TOTAL COUNT SECTION
        .row.g-4

            .col-lg-3
                .card.p-4.dashboard-card
                    .d-flex.justify-content-between.align-items-center
                        div
                            p.text-muted.mb-1 Total Employees
                            h2.fw-bold#totalEmployees 0
                        .icon-box.bg-primary-subtle.text-primary
                            i.bi.bi-people.fs-4

            .col-lg-3
                .card.p-4.dashboard-card
                    .d-flex.justify-content-between.align-items-center
                        div
                            p.text-muted.mb-1 Total Assets
                            h2.fw-bold#totalAssets 0
                        .icon-box.bg-success-subtle.text-success
                            i.bi.bi-box.fs-4

            .col-lg-3
                .card.p-4.dashboard-card
                    .d-flex.justify-content-between.align-items-center
                        div
                            p.text-muted.mb-1 Issued Assets
                            h2.fw-bold#issuedAssets 0
                        .icon-box.bg-warning-subtle.text-warning
                            i.bi.bi-box-arrow-up-right.fs-4

            .col-lg-3
                .card.p-4.dashboard-card
                    .d-flex.justify-content-between.align-items-center
                        div
                            p.text-muted.mb-1 Stock Assets
                            h2.fw-bold#stockAssets 0
                        .icon-box.bg-secondary-subtle.text-dark
                            i.bi.bi-house.fs-4


        // RECENT ACTIVITY SECTION
        .row.mt-4
            .col-12
                .card.p-4.activity-card
                    h5.mb-4 Asset Recent Activity
                    #activityContainer

        script(type="module" src="./ts/dashboard.ts")
