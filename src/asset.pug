extends layout.pug

block content

    .topbar.d-flex.justify-content-between.align-items-center.p-3
        h5.mb-0 Assets

    .container-fluid.p-4

        .section.d-flex.justify-content-between.align-items-center.mb-4
            .left-content
                h5.mb-1 Asset Management
                p.text-muted.mb-0 Manage and track all company assets

            .right-content
                button.btn.btn-dark#addAssetBtn + Add Asset

        .card.search-card.p-3.mb-3
            .filter-wrapper.d-flex.justify-content-between.align-items-center.flex-wrap

                .search-container.position-relative
                    i.bi.bi-search.search-icon
                    input#customSearch.form-control.search-input(
                        type="text"
                        placeholder="Search by name, category, or ID..."
                    )

                .category-container
                    select#categoryFilter.form-select.status-select
                        option(value="") All Category
                .branch-container
                    select#assetBranch.form-select.status-select
                        option(value="") All Branch
                .status-container
                    select#assetStatus.form-select.status-select
                        option(value="") All Status

        .card.p-3
            .table-responsive
                table#assetTable.table.table-striped(style="width:100%")
                    thead
                        tr
                            th Asset Details
                            th Category
                            th Make / Model
                            th Branch
                            th Status
                            th Created At
                            th Action
                    tbody


        script(type="module" src="./ts/asset.ts")
